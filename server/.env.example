# Copy this file to .env and fill in real values. Never commit .env.

# MongoDB Atlas connection string (must be a replica set; Atlas always is)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/skillswap

# Long random string used to sign login tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me

JWT_EXPIRES_IN=7d
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Optional: a TURN relay for video calls on strict networks (offices, some
# colleges). Without it, calls still work on most home and mobile networks.
# TURN_URLS=turn:example.metered.live:80,turns:example.metered.live:443
# TURN_USERNAME=
# TURN_CREDENTIAL=
